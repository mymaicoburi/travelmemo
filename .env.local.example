# Supabase 設定。Supabase のプロジェクト Settings → API から取得。
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# anon key (public) — 現状の構成では使用しません。将来のクライアント直叩き用に控えとして記載。
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role key — サーバー側 (Server Actions) からのみ使用。絶対にクライアントに露出しないこと。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key — 予約メール解析機能 (LLM による構造化抽出) で使用。
# Vercel と .env.local の両方に設定。NEXT_PUBLIC_ プレフィックスは付けないこと。
# 取得: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key
