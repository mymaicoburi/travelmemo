# Supabase 設定。Supabase のプロジェクト Settings → API から取得。
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# anon key (public) — 現状の構成では使用しません。将来のクライアント直叩き用に控えとして記載。
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role key — サーバー側 (Server Actions) からのみ使用。絶対にクライアントに露出しないこと。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
